# Copy to .env and fill in real values. .env is git-ignored (ADR-0013);
# this file is the only one committed.

APP_ENV=development

# Consumed by both the `db` service (official Postgres image env vars) and
# the `app` service (typed settings, src/moj_projekt/config/settings.py).
POSTGRES_DB=moj_projekt
POSTGRES_USER=moj_projekt
POSTGRES_PASSWORD=change-me

# Host-side commands (alembic, seed, run_once, pytest) talk to the published
# db port. compose.yaml maps it to 5433 by default (`POSTGRES_HOST_PORT`).
# The `app` container overrides these to `db:5432` via compose.yaml's
# `environment:` block - do not remove that override.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM provider (ADR-0010). Placeholder only - never commit a real key
# (ADR-0013, D-S002-04 clause 13). Default tests use FakeLLMClient; a live
# key is needed only for the smoke task.
ANTHROPIC_API_KEY=

# Per-cycle extract cap (ADR-0015). Bounds how many COLLECTED Documents
# one cycle will send to the model.
CYCLE_EXTRACT_DOCUMENT_CAP=20

# Monthly LLM cost ceiling and the soft threshold as a fraction of it
# (ADR-0015). The extract stage stops issuing calls at the ceiling;
# the soft threshold is recorded but does not change behaviour.
LLM_MONTHLY_CEILING_USD=10
LLM_MONTHLY_SOFT_THRESHOLD_RATIO=0.80

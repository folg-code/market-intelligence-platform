{
  "$id": "moj-projekt:event-extraction-output-schema:v1",
  "title": "Event extraction output schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/extracted_event" }
    }
  },
  "$defs": {
    "extracted_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "occurred_at",
        "confidence",
        "entities",
        "topics",
        "candidate_mechanism",
        "affected_entities_or_exposures",
        "candidate_interpretation",
        "extracted_facts",
        "source_claims"
      ],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "entities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "topics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "candidate_mechanism": { "type": "string", "minLength": 1 },
        "affected_entities_or_exposures": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "candidate_interpretation": { "type": "string", "minLength": 1 },
        "extracted_facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/extracted_fact" }
        },
        "source_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_claim" }
        }
      }
    },
    "extracted_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "epistemic_category"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "epistemic_category": { "const": "observed_fact" },
        "source_span": { "type": "string", "minLength": 1 }
      }
    },
    "source_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "epistemic_category"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "epistemic_category": { "const": "source_claim" },
        "source_span": { "type": "string", "minLength": 1 },
        "attributed_to": { "type": "string", "minLength": 1 }
      }
    }
  }
}
